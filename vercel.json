{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/magasinier", "destination": "/magasinier.html" },
    { "source": "/((?!magasinier).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
